# Copie este arquivo para ".env" (nunca commitar o .env de verdade).

# Chave de IA (obrigatória em produção, o boot aborta sem ela)
GEMINI_API_KEY=
# Login compartilhado: usuário e senha únicos pra toda a equipe (obrigatórios em produção).
SITE_USERNAME=citi
SITE_PASSWORD=citi123

PORT=8787

# Origens permitidas no CORS, separadas por vírgula.
# Em dev o default é http://localhost:5173. Obrigatória em produção.
ALLOWED_ORIGINS=

# Coloque 1 quando a API estiver atrás de reverse proxy (nginx, Cloudflare),
# senão o rate limit por IP enxerga o IP do proxy em vez do IP real.
TRUST_PROXY=

# Timeout das chamadas de texto (Gemini), em ms (default 60000).
LLM_TIMEOUT_MS=

# Nível de log do pino (default: debug em dev, info em produção).
LOG_LEVEL=

# Tetos de rate limit por hora (defaults entre parênteses):
# RATE_GENERATE_IP (10)      RATE_GENERATE_SESSION (5)
# RATE_CHAT_IP (60)          RATE_CHAT_SESSION (30)
# RATE_IMPROVE_IP (30)       RATE_IMPROVE_SESSION (15)
# RATE_IMAGE_IP (30)         RATE_IMAGE_SESSION (10)   <- usado pelo export-canva
# RATE_AUTH_IP (20)          RATE_AUTH_SESSION (10)    <- usado pelo login
# RATE_IMAGE_GEN_IP (12)     RATE_IMAGE_GEN_SESSION (6) <- geração de imagem com IA no editor
# RATE_NOTION_IP (40)        RATE_NOTION_SESSION (20)   <- importar briefing do Notion

# Integração Canva (Connect API) -- pega no Developer Portal (canva.com/developers)
# ao criar a integração. Ver api/README.md pra passo a passo.
CANVA_CLIENT_ID=
CANVA_CLIENT_SECRET=
# Precisa ser cadastrada nos "Authorized redirects" da integração, exatamente igual.
CANVA_REDIRECT_URI=http://127.0.0.1:8787/api/canva/oauth/callback

# Geração de imagem sob demanda no editor (OpenAI Images, gpt-image-1). Opcional --
# sem a chave, o botão continua na UI mas devolve erro. É a ação mais cara do app.
OPENAI_API_KEY=
# low | medium | high (default: low). 'high' custa MUITO mais por imagem -- só suba
# se souber o motivo.
OPENAI_IMAGE_QUALITY=

# Importar briefing direto de uma página do Notion no wizard de criação. Crie uma
# integração interna em notion.so/my-integrations, copie o token daqui, e depois
# compartilhe cada página que o time for usar com essa integração (menu ••• da
# página > Conectar a). Opcional -- sem a chave, o botão de importar não aparece.
NOTION_API_KEY=
