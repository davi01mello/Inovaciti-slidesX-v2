{
  "name": "citi-slides-api",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "description": "Backend do CITi Slides: agente conversacional (Gemini) que gera e edita o storyboard, e integracao com a Canva (import do pptx montado no front).",
  "scripts": {
    "predev": "node ../scripts/check-contract.mjs",
    "dev": "tsx watch src/index.ts",
    "prebuild": "node ../scripts/check-contract.mjs",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@google/genai": "^1.7.0",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^8.5.2",
    "helmet": "^8.2.0",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/compression": "^1.8.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.2",
    "pino-pretty": "^13.1.3",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
